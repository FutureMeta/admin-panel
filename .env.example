# Copia in .env e riempi. `.env` è in .gitignore e non ci deve entrare mai.
#
# In produzione le variabili le inietta la piattaforma, non un file:
# @dotenvx/dotenvx rientra solo se il team supera le ~8 persone con accesso ai
# segreti (§4).

NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Origine ESATTA. SEC-15 la confronta e basta: nessun wildcard, nessuna lista.
APP_ORIGIN=http://localhost:3000

# CIDR del proxy, MAI `true` (SEC-22). Con `true` chiunque può dichiarare il
# proprio IP con un header e falsificare rate limit e audit.
TRUST_PROXY_CIDR=127.0.0.1/32

DATABASE_URL=postgres://metamc_app:password@127.0.0.1:5432/metamc
DATABASE_MIGRATE_URL=postgres://metamc_migrate:password@127.0.0.1:5432/metamc
PG_POOL_MAX=6

REDIS_URL=redis://127.0.0.1:6379

# 32 byte in esadecimale. Tutte le altre chiavi sono derivate con HKDF e un
# `info` distinto per scopo (SEC-39):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# SEC-40 — la rotazione del pepper passa da qui. Cambiarlo senza alzare questo
# numero invaliderebbe TUTTI gli hash password.
PEPPER_VERSION=1

# §5.1 — numero di core REALI, mai il default 4. Il threadpool libuv è
# condiviso da Argon2, fs, dns e zlib.
UV_THREADPOOL_SIZE=8

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM=MetaMC Admin <no-reply@metamc.it>

# D-11 (docs/security/deviations.md): quattordici giorni di tetto assoluto,
# nessun timeout di inattivita' (0 = spento). Qui c'era la politica vecchia,
# otto ore e mezz'ora: chi copiava questo file la riportava in vita.
SESSION_ABSOLUTE_SECONDS=1209600
SESSION_IDLE_SECONDS=0

LOG_LEVEL=info

# §10 — dove il job di ancoraggio scrive le teste di partizione firmate.
# AUDIT_ANCHOR_PATH=./audit-anchor.jsonl

# Solo in SVILUPPO, per le macchine senza un Redis vero: il rate limit tiene i
# contatori in memoria. In produzione il processo si rifiuta di partire.
# RATE_LIMIT_IN_MEMORY=1

# --- statistiche, fase 2 ---------------------------------------------------
# Il campionamento e' spento finche' non lo si accende: accenderlo scrive ~2.900
# righe al giorno e apre una connessione al Redis di gioco. Deve essere una
# decisione, non la conseguenza di un aggiornamento.
STATS_INGEST_ENABLED=0
# Il ruolo che scrive le statistiche: metamc_ingest, MAI metamc_app. Il ruolo
# che regge i login non deve poter scrivere nel grezzo. Obbligatoria quando
# STATS_INGEST_ENABLED=1.
# DATABASE_INGEST_URL=postgres://metamc_ingest:password@127.0.0.1:5432/metamc
# Il Redis di gioco. Se assente si usa REDIS_URL, perche' in questa
# installazione e' la stessa istanza: il client resta comunque separato.
# GAME_REDIS_URL=redis://:password@127.0.0.1:6379/0
# Il pattern dell'insieme online, misurato dalla sonda del passo 0.
GAME_REDIS_PATTERN=metaverse:player:*
# Il ruolo dei giri di rollup. In assenza usa quello del campionamento: cambia
# solo quale timeout eredita chi si collega a mano. Il pool resta separato.
# DATABASE_ROLLUP_URL=postgres://metamc_rollup:password@127.0.0.1:5432/metamc

# Il ruolo di SOLA LETTURA delle statistiche. Vede le viste, non le tabelle di
# fatto: chi leggesse i rollup nudi disegnerebbe zeri al posto dei buchi e medie
# con il denominatore sbagliato. Senza, le rotte /api/stats rispondono 503.
# DATABASE_STATS_URL=postgres://metamc_stats:password@127.0.0.1:5432/metamc

# Il Redis dei payload statistici. In assenza si usa REDIS_URL.
# CACHE_REDIS_URL=redis://127.0.0.1:6379/1
# Il database GeoLite2-Country. Assente = geolocalizzazione spenta: il paese
# resta NULL e la mappa non compare.
# GEO_MMDB_PATH=/srv/metamc-admin/GeoLite2-Country.mmdb

# --- gioco (MariaDB) --------------------------------------------------------
# Il MySQL dei duels, in SOLA LETTURA: SELECT sulle tabelle che
# `src/duels/mysql.ts` nomina e su nient'altro.
# DUELS_MYSQL_URL=mysql://metamc_panel:password@127.0.0.1:3306/duels
# L'ingestione delle partite. Spenta finche' non la si accende: PRIMA si
# importa lo storico con `pnpm run duels:backfill`, poi si accende questa.
DUELS_INGEST_ENABLED=0
# Il fuso in cui il server di gioco scrive `created_at`: un fuso, non un offset.
DUELS_SOURCE_TZ=Europe/Rome
# Il segreto con cui i server di gioco chiedono il bundle delle configurazioni
# (almeno 24 caratteri). Vive anche nel `credentials.yml` del plugin.
# DUELS_CONFIG_TOKEN=
# Il MariaDB di Metaverse, database `metamc`, per la sezione Lingue: il
# pannello legge e scrive i testi dove li tiene il plugin, che se ne accorge
# da solo entro un minuto. L'utente vuole SELECT, INSERT, UPDATE e DELETE su
# `metaverse_message` e `metaverse_language`, e niente altro (il DELETE serve
# a togliere una lingua). Senza la variabile, le rotte /api/lang rispondono 503.
# METAVERSE_MYSQL_URL=mysql://metamc_lang:password@127.0.0.1:3306/metamc

# --- assistente e traduzioni con l'AI ----------------------------------------
# La chiave di Anthropic vive SOLO qui, nel processo Node: non raggiunge mai il
# browser. Assente = assistente e «Traduci con l'AI» spenti (503).
# ANTHROPIC_API_KEY=
# Il ruolo di sola lettura dei tool dell'assistente: metamc_assistant, MAI
# metamc_app (migration 019).
# DATABASE_ASSISTANT_URL=postgres://metamc_assistant:password@127.0.0.1:5432/metamc
ASSISTANT_EFFORT=medium
# Tetto di spesa MENSILE in dollari, condiviso con le traduzioni. 0 = nessun tetto.
ASSISTANT_MONTHLY_BUDGET_USD=50
ASSISTANT_TIMEOUT_MS=60000
