# Versioni sempre esatte: niente ^, niente ~ (§3 stack-decisioni.md).
save-exact=true
save-prefix=

# Nessuno script post-install eseguito dai pacchetti: allowlist esplicita in
# pnpm.onlyBuiltDependencies di package.json quando serve davvero (§12).
# In CI: pnpm install --frozen-lockfile --ignore-scripts

# engine-strict resta false di proposito: `engines.node` dichiara il target
# di produzione (24.19.0) ma lo sviluppo locale puo' girare su Node >= 22.18
# (type stripping nativo gia' attivo). Il vincolo duro e' applicato dal
# Dockerfile e dalla matrice CI, non dall'installer.
engine-strict=false
