{
  "name": "metamc-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "imports": {
    "#src/*": "./src/*",
    "#scripts/*": "./scripts/*",
    "#tests/*": "./tests/*",
    "#web/*": "./web/src/*"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/server/main.ts",
    "start": "node src/server/main.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "lint": "biome check --max-diagnostics=200 .",
    "lint:fix": "biome check --write --max-diagnostics=200 .",
    "lint:guards": "node scripts/check-guards.ts",
    "check": "pnpm run lint:guards && pnpm run lint:identifiers && pnpm run lint:deps && pnpm run lint:pg17 && pnpm run typecheck && pnpm run lint",
    "migrate": "node scripts/migrate.ts up",
    "migrate:status": "node scripts/migrate.ts status",
    "bootstrap:owner": "node scripts/bootstrap-owner.ts",
    "invite:owner": "node scripts/invite-owner.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:web": "vite build && node scripts/check-build.ts",
    "dev:web": "vite",
    "email:preview": "email dev --dir src/email/templates",
    "lint:identifiers": "node scripts/check-identifiers.ts",
    "lint:deps": "node scripts/check-deps.ts",
    "job:anchor": "node scripts/maintenance.ts anchor",
    "job:partitions": "node scripts/maintenance.ts partitions",
    "job:cleanup": "node scripts/maintenance.ts cleanup",
    "job:verify": "node scripts/maintenance.ts verify",
    "lint:pg17": "node scripts/check-pg17.ts",
    "stats:roles": "node scripts/create-stats-roles.ts",
    "probe:redis": "node scripts/probe-game-redis.ts"
  },
  "dependencies": {
    "@better-auth/redis-storage": "1.6.29",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.0",
    "@fastify/under-pressure": "9.1.0",
    "@node-rs/argon2": "2.1.0",
    "@react-email/render": "2.1.0",
    "better-auth": "1.6.29",
    "close-with-grace": "2.5.0",
    "fastify": "5.12.0",
    "ioredis": "5.11.1",
    "kysely": "0.29.5",
    "maxmind": "5.0.7",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "qrcode-generator": "2.0.4",
    "rate-limiter-flexible": "11.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.20.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.29",
    "@tanstack/react-table": "8.21.3",
    "@types/node": "24.13.3",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "json-schema-to-ts": "3.1.1",
    "react-email": "6.9.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
