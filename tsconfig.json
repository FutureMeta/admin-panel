{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // Il type stripping nativo di Node IGNORA completamente tsconfig.json:
    // qui si fa solo type checking (`tsc --noEmit`). erasableSyntaxOnly
    // impedisce di scrivere sintassi che Node non saprebbe cancellare
    // (enum, namespace, parameter properties). §3.1
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": false,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
  // `spikes/` e' escluso: sono diagnostiche gia' eseguite, conservate come
  // prova riproducibile degli esiti del §15. Girano sotto il type stripping
  // di Node, non sono codice di produzione, e sottoporle a `strict` +
  // `exactOptionalPropertyTypes` produrrebbe rumore su file che non
  // cambieranno piu'.
  "exclude": ["node_modules", "dist", "web", "spikes"]
}
